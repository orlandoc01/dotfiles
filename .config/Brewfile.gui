tap "felixkratz/formulae"
tap "asmvik/formulae"

# macOS desktop environment
brew "felixkratz/formulae/sketchybar"
brew "asmvik/formulae/skhd"
brew "asmvik/formulae/yabai"
brew "media-control" # event-based now-playing for the sketchybar media widget

# Fonts
cask "font-fira-code"
cask "font-fira-code-nerd-font"
cask "font-hack-nerd-font"
cask "font-menlo-for-powerline"
cask "font-meslo-for-powerline"
cask "font-meslo-lg-nerd-font"
cask "font-sketchybar-app-font"

# Terminal
cask "alacritty"

# Productivity
cask "1password"
cask "1password-cli"
cask "flux-app"
cask "macdown"
cask "raycast"
cask "sf-symbols"
cask "the-unarchiver"

# Browsers
cask "brave-browser"
cask "firefox"
cask "google-chrome"
cask "microsoft-edge"

# Communication
cask "discord"
cask "slack"

# Development
cask "charles"
cask "claude"
cask "claude-code"
cask "docker-desktop"
cask "ngrok"
cask "postman"
cask "sourcetree"

# Entertainment
cask "spotify"
cask "vlc"
cask "vuze"

# Cloud & security
